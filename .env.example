# Port public UNIC (site + API pe acelasi DNS). Ex: APP_PORT=4000 => site http://localhost:4000 + API http://localhost:4000/api/health
APP_PORT=4000
# URL public al site-ului (linkuri in emailuri + Telegram)
APP_URL=http://localhost:4000

# Secret JWT (schimba in productie, min 32 caractere)
JWT_SECRET=schimba-ma-in-productie-min-32-caractere

# Conturi initiale (create la primul seed)
ADMIN_EMAIL=admin@gustbebe.md
ADMIN_PASSWORD=Admin123!
MODERATOR_EMAIL=moderator@gustbebe.md
MODERATOR_PASSWORD=Mod12345!

# Email SMTP (confirmarea conturilor). Daca lipseste SMTP_HOST, linkul se afiseaza in consola (mod dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GustBebe <no-reply@gustbebe.md>

# Telegram (publicare retete pe canal). Gol = dezactivat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@gustbebe
